# ─── FORK environment ────────────────────────────────────────────────
# Copy to `.env` (never commit `.env`). All variables are read at build time
# by Expo and MUST be prefixed with EXPO_PUBLIC_ to be available in the app.

# Demo mode: seeded, deterministic scenarios — no external AI calls.
# The UI clearly labels demo output as "seeded demo data", never as real AI.
EXPO_PUBLIC_DEMO_MODE=true

# AI provider ("groq" | "demo"). Only used when EXPO_PUBLIC_DEMO_MODE=false.
# Groq offers a free API key at https://console.groq.com/keys
EXPO_PUBLIC_AI_PROVIDER=groq
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile

# RevenueCat public SDK keys (these are PUBLIC app keys, not secret keys).
# Get them from https://app.revenuecat.com → Project → API keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# RevenueCat identifiers (configurable, must match your RevenueCat dashboard)
EXPO_PUBLIC_RC_ENTITLEMENT_ID=fork_pro
EXPO_PUBLIC_RC_PRODUCT_MONTHLY=fork_pro_monthly
EXPO_PUBLIC_RC_PRODUCT_YEARLY=fork_pro_yearly
