# FORK backend configuration (copy to .env). Everything here is BACKEND-ONLY —
# the React frontend never receives any of these values.

APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# PostgreSQL is the source of truth. Redis is optional: if unreachable the
# backend falls back to an in-process cache (fine for local development).
DATABASE_URL=postgresql+psycopg://fork:fork@localhost:5432/fork
REDIS_URL=redis://localhost:6379/0

# Change this in production (>= 16 chars).
JWT_SECRET=change-me-in-production-please
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ---- AI -------------------------------------------------------------------
# Default provider is Gemini (free tier). No key is required: when
# GEMINI_API_KEY is empty, or the Gemini API fails, FORK automatically uses
# deterministic DEMO responses so everything keeps working. No credit card or
# paid API is ever needed for local development.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional alternatives (never required):
# AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Plans & usage ----------------------------------------------------------
TRIAL_SIMULATIONS=5
FREE_DAILY_SIMULATIONS=3
WEEKLY_PRICE_UGX=3000
PRO_MONTHLY_PRICE_UGX=10000

# ---- Payments (Mobile Money) -----------------------------------------------
# PAYMENTS_DEMO=true simulates MTN/Airtel handset authorization locally.
# FORK NEVER asks for, stores, or transmits Mobile Money PINs — authorization
# always happens on the payer's handset via the provider.
PAYMENTS_DEMO=true
MTN_MERCHANT_NUMBER=
MTN_API_USER=
MTN_API_KEY=
MTN_SUBSCRIPTION_KEY=
MTN_ENVIRONMENT=sandbox
MTN_WEBHOOK_SECRET=
AIRTEL_MERCHANT_NUMBER=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_WEBHOOK_SECRET=
PAYMENT_EXPIRY_MINUTES=15

# ---- Media / realtime (later phases) --------------------------------------
MEDIA_BACKEND=local
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
